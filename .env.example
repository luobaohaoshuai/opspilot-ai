# Copy this file to .env and replace every placeholder before starting the project.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=demo
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-at-least-32-random-bytes
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
ZHIPU_API_KEY=replace-with-your-zhipu-key
